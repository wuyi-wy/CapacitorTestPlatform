<Page x:Class="CapacitorTestPlatform.UI.Views.TestPageView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      Background="#F5F6FA">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Plan Info Header + Device Button -->
        <hc:Card Grid.Row="0" Margin="0,0,0,15" Padding="15">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="计划号:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding PlanNo}" VerticalAlignment="Center" Margin="0,0,25,0"/>

                <TextBlock Text="产品型号:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding ProductModel}" VerticalAlignment="Center" Margin="0,0,25,0"/>

                <TextBlock Text="实验项目:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding TestItem}" VerticalAlignment="Center" Margin="0,0,25,0"/>

                <Button Content="设备采集" Command="{Binding AcquireDataCommand}"
                        Style="{StaticResource BtnPrimary}" Padding="20,8"/>
            </WrapPanel>
        </hc:Card>

        <!-- Test Data Grid (dynamic columns) -->
        <hc:Card Grid.Row="1" Margin="0,0,0,10" Padding="0">
            <DataGrid x:Name="TestDataGrid"
                      ItemsSource="{Binding TestDataTable.Rows}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      IsReadOnly="False"/>
        </hc:Card>

        <!-- Bottom Action Bar -->
        <hc:Card Grid.Row="2" Padding="12" Margin="0,0,0,5">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="样机编号:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Text="{Binding SpecimenNumber, UpdateSourceTrigger=PropertyChanged}"
                         Width="150" Margin="0,0,20,0" hc:InfoElement.Placeholder="输入样机编号"/>

                <Button Content="保存数据" Command="{Binding SaveDataCommand}"
                        Style="{StaticResource BtnPrimary}" Padding="18,6" Margin="0,0,10,0"/>
                <Button Content="上报数据" Command="{Binding UploadDataCommand}"
                        Style="{StaticResource BtnWarning}" Padding="18,6" Margin="0,0,10,0"/>
                <Button Content="清空数据" Command="{Binding ClearDataCommand}"
                        Style="{StaticResource BtnSuccess}" Padding="18,6"/>
            </WrapPanel>
        </hc:Card>

        <!-- Status Bar (separate row, no overlap) -->
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}"
                   Foreground="#7F8C8D" FontSize="12" Margin="5,0,5,5"/>
    </Grid>
</Page>

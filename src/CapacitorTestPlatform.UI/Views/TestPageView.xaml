<Page x:Class="CapacitorTestPlatform.UI.Views.TestPageView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      xmlns:models="clr-namespace:CapacitorTestPlatform.UI.Models"
      xmlns:vm="clr-namespace:CapacitorTestPlatform.UI.ViewModels"
      xmlns:views="clr-namespace:CapacitorTestPlatform.UI.Views"
      Background="#F5F6FA">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Multi-table template: inner TabControl (LCR数字电桥) -->
        <DataTemplate x:Key="MultiTableTemplate" DataType="{x:Type vm:DeviceCategoryTab}">
            <TabControl ItemsSource="{Binding Tables}"
                        SelectedItem="{Binding DataContext.ActiveTable,
                            RelativeSource={RelativeSource AncestorType=Page}}"
                        Background="Transparent" BorderThickness="0" Margin="5">
                <TabControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:TestDataTable}">
                        <TextBlock Text="{Binding DisplayName}" Margin="6,3"/>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type models:TestDataTable}">
                        <DataGrid ItemsSource="{Binding Rows}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  SelectionMode="Single"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  IsReadOnly="False"
                                  Loaded="DataGrid_Loaded"
                                  DataContextChanged="DataGrid_DataContextChanged"/>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </DataTemplate>

        <!-- Single-table template -->
        <DataTemplate x:Key="SingleTableTemplate" DataType="{x:Type vm:DeviceCategoryTab}">
            <DataGrid ItemsSource="{Binding Tables[0].Rows}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      IsReadOnly="False"
                      Loaded="DataGrid_Loaded"/>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Plan Info Header + Toggle -->
        <hc:Card Grid.Row="0" Margin="0,0,0,15" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <WrapPanel VerticalAlignment="Center" Grid.Column="0">
                    <TextBlock Text="计划号:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding PlanNo}" VerticalAlignment="Center" Margin="0,0,25,0"/>

                    <TextBlock Text="产品型号:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding ProductModel}" VerticalAlignment="Center" Margin="0,0,25,0"/>

                    <TextBlock Text="实验项目:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding TestItem}" VerticalAlignment="Center" Margin="0,0,25,0"/>

                    <Button Content="设备采集" Command="{Binding AcquireDataCommand}"
                            Style="{StaticResource BtnPrimary}" Padding="20,8"/>
                </WrapPanel>
                <ToggleButton Grid.Column="1"
                              IsChecked="{Binding IsConcentratedMode}"
                              Padding="12,6" MinWidth="90">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Content" Value="集中显示"/>
                            <Setter Property="Background" Value="#E8EAF6"/>
                            <Setter Property="BorderBrush" Value="#C5CAE9"/>
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Content" Value="多选项卡"/>
                                    <Setter Property="Background" Value="#C5CAE9"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
            </Grid>
        </hc:Card>

        <!-- 多选项卡模式 -->
        <hc:Card Grid.Row="1" Margin="0,0,0,10" Padding="0"
                 Visibility="{Binding IsConcentratedMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <TabControl x:Name="DeviceTabs"
                        ItemsSource="{Binding DeviceTabs}"
                        SelectedItem="{Binding ActiveDeviceTab}"
                        Background="Transparent" BorderThickness="0">
                <TabControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DeviceCategoryTab}">
                        <TextBlock Text="{Binding Category}" Margin="8,4"/>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplateSelector>
                    <views:DeviceCategoryTemplateSelector
                        MultiTableTemplate="{StaticResource MultiTableTemplate}"
                        SingleTableTemplate="{StaticResource SingleTableTemplate}"/>
                </TabControl.ContentTemplateSelector>
            </TabControl>
        </hc:Card>

        <!-- 集中显示模式 -->
        <hc:Card Grid.Row="1" Margin="0,0,0,10" Padding="10"
                 Visibility="{Binding IsConcentratedMode, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding DeviceTabs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DeviceCategoryTab}">
                            <ItemsControl ItemsSource="{Binding Tables}" Margin="0,0,0,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:TestDataTable}">
                                        <StackPanel Margin="0,0,0,15">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                                            <DataGrid ItemsSource="{Binding Rows}"
                                                      AutoGenerateColumns="False"
                                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                                      SelectionMode="Single"
                                                      GridLinesVisibility="Horizontal"
                                                      HeadersVisibility="Column"
                                                      IsReadOnly="False"
                                                      MaxHeight="400"
                                                      Loaded="ConcentratedDataGrid_Loaded"/>
                                            <Separator Margin="0,10,0,0" Background="#E0E0E0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </hc:Card>

        <!-- Bottom Action Bar -->
        <hc:Card Grid.Row="2" Padding="12" Margin="0,0,0,5">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="样机编号:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Text="{Binding SpecimenNumber, UpdateSourceTrigger=PropertyChanged}"
                         Width="150" Margin="0,0,20,0" hc:InfoElement.Placeholder="输入样机编号"/>

                <Button Content="保存数据" Command="{Binding SaveDataCommand}"
                        Style="{StaticResource BtnPrimary}" Padding="18,6" Margin="0,0,10,0"/>
                <Button Content="上报数据" Command="{Binding UploadDataCommand}"
                        Style="{StaticResource BtnWarning}" Padding="18,6" Margin="0,0,10,0"/>
                <Button Content="清空数据" Command="{Binding ClearDataCommand}"
                        Style="{StaticResource BtnSuccess}" Padding="18,6"/>
            </WrapPanel>
        </hc:Card>

        <!-- Status Bar -->
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}"
                   Foreground="#7F8C8D" FontSize="12" Margin="5,0,5,5"/>
    </Grid>
</Page>

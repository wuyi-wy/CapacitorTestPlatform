<Page x:Class="CapacitorTestPlatform.UI.Views.PlanImportView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      Background="#F5F6FA">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="计划导入" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>

        <!-- Filter Bar -->
        <hc:Card Grid.Row="1" Margin="0,0,0,15" Padding="12">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="台位:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox Width="160" ItemsSource="{Binding Stations}"
                          SelectedItem="{Binding SelectedStation}" Margin="0,0,15,0"/>

                <TextBlock Text="搜索:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Width="200" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                         hc:InfoElement.Placeholder="输入计划号或型号" Margin="0,0,15,0"/>

                <Button Content="搜索" Command="{Binding SearchCommand}"
                        Style="{StaticResource BtnPrimary}"
                        Margin="0,0,10,0" Padding="18,6"/>
                <Button Content="加载计划" Command="{Binding LoadPlansCommand}"
                        Style="{StaticResource BtnPrimary}"
                        Padding="18,6"/>
            </WrapPanel>
        </hc:Card>

        <!-- Plan DataGrid -->
        <hc:Card Grid.Row="2">
            <DataGrid ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Single" AlternatingRowBackground="#F8F9FA"
                      GridLinesVisibility="Horizontal" BorderThickness="0">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="申请单号" Binding="{Binding ContractNumber}" Width="150"/>
                    <DataGridTextColumn Header="样品型号" Binding="{Binding SampleType}" Width="180"/>
                    <DataGridTextColumn Header="实验项目" Binding="{Binding TestItems}" Width="*"/>
                    <DataGridTextColumn Header="工站" Binding="{Binding InstrumentNumber}" Width="120"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding StatusName}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="8,2"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="操作" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="测试" Command="{Binding DataContext.GoToTestCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" Style="{StaticResource BtnSuccess}" Padding="12,4"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </hc:Card>

        <!-- Status Bar -->
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" VerticalAlignment="Bottom"
                   Foreground="#7F8C8D" FontSize="12" Margin="5"/>
    </Grid>
</Page>
